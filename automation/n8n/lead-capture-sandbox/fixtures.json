      "request_id": "qa-request-0002"
    },
    "expectValid": true
  },
  {
    "name": "consentimiento ausente",
    "body": {
      "nombre": "QA Formulario 003",
      "email": "qa+sin-consentimiento@example.invalid",
      "request_id": "qa-request-0003"
    },
    "expectValid": false,
    "expectInvalidField": "consentimiento_contacto"
  },
  {
    "name": "correo inválido",
    "body": {
      "nombre": "QA Formulario 004",
      "email": "correo-invalido",
      "consentimiento_contacto": "si",
      "request_id": "qa-request-0004"
    },
    "expectValid": false,
    "expectInvalidField": "email"
  },
  {
    "name": "opción manipulada",
    "body": {
      "nombre": "QA Formulario 005",
      "email": "qa+opcion@example.invalid",
      "tipo_negocio": "Administrador total",
      "consentimiento_contacto": "si",
      "request_id": "qa-request-0005"
    },
    "expectValid": false,
    "expectInvalidField": "tipo_negocio"
  },
  {
    "name": "campo inesperado ignorado",
    "body": {
      "nombre": "QA Formulario 006",
      "email": "qa+campo@example.invalid",
      "consentimiento_contacto": "si",
      "request_id": "qa-request-0006",
      "precio": "1"
    },
    "expectValid": true,
    "expectIgnoredField": "precio"
  },
  {
    "name": "mensaje extenso rechazado",
    "body": {
      "nombre": "QA Formulario 007",
      "email": "qa+largo@example.invalid",
