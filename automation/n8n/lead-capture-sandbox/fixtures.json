      "request_id": "qa-request-0007"
    },
    "expectValid": false,
    "expectInvalidField": "mensaje"
  },
  {
    "name": "HTML tratado como texto",
    "body": {
      "nombre": "QA Formulario 008",
      "email": "qa+html@example.invalid",
      "mensaje": "<script>globalThis.comprometido=true</script>",
      "consentimiento_contacto": "si",
      "request_id": "qa-request-0008"
    },
    "expectValid": true,
    "expect": {
      "mensaje": "<script>globalThis.comprometido=true</script>"
    }
  }
