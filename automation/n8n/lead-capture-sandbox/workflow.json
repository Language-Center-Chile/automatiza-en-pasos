      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input && typeof input.body === 'object' && input.body !== null ? input.body : input;\nconst headers = input && typeof input.headers === 'object' && input.headers !== null ? input.headers : {};\nconst permitted = new Set(['nombre', 'email', 'whatsapp', 'tipo_negocio', 'plan_interes', 'mensaje', 'consentimiento_contacto', 'request_id']);\nconst ignoredFields = Object.keys(body || {}).filter((key) => !permitted.has(key));\nconst clean = (value) => typeof value === 'string' ? value.trim() : '';\nconst nombre = clean(body.nombre).replace(/\\s+/g, ' ');\nconst email = clean(body.email).toLowerCase();\nconst whatsapp = clean(body.whatsapp);\nconst tipoNegocio = clean(body.tipo_negocio);\nconst planInteres = clean(body.plan_interes);\nconst mensaje = clean(body.mensaje);\nconst consentimiento = clean(body.consentimiento_contacto);\nconst allowedBusinessTypes = new Set(['', 'Emprendedor / pyme', 'Consultor / agencia', 'Instituto / servicios', 'Equipo administrativo', 'Otro']);\nconst allowedPlans = new Set(['', 'Pro', 'Empresa', 'Aún no lo sé']);\nconst issues = [];\nif (nombre.length < 2 || nombre.length > 100) issues.push('nombre');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email) || email.length > 254) issues.push('email');\nif (consentimiento !== 'si') issues.push('consentimiento_contacto');\nif (whatsapp && (!/^[+0-9() .-]{7,30}$/.test(whatsapp))) issues.push('whatsapp');\nif (!allowedBusinessTypes.has(tipoNegocio)) issues.push('tipo_negocio');\nif (!allowedPlans.has(planInteres)) issues.push('plan_interes');\nif (mensaje.length > 1000) issues.push('mensaje');\nconst headerRequestId = clean(headers['x-request-id'] || headers['X-Request-Id']);\nconst bodyRequestId = clean(body.request_id);\nconst suppliedRequestId = headerRequestId || bodyRequestId;\nif (suppliedRequestId && !/^[A-Za-z0-9._:-]{8,128}$/.test(suppliedRequestId)) issues.push('request_id');\nconst requestId = suppliedRequestId || ('req_sandbox_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 10));\nconst hash = (text) => { let value = 2166136261; for (let i = 0; i < text.length; i += 1) { value ^= text.charCodeAt(i); value = Math.imul(value, 16777619); } return (value >>> 0).toString(16).padStart(8, '0'); };\nconst leadId = 'lead_' + hash(requestId);\nconst valid = issues.length === 0;\nif (!valid) {\n  return [{ json: { valid: false, status_code: 422, response: { ok: false, error: 'invalid_submission', invalid_fields: [...new Set(issues)], request_id: requestId } } }];\n}\nreturn [{ json: { valid: true, lead_id: leadId, request_id: requestId, received_at: new Date().toISOString(), fuente: 'landing_7_pasos', nombre, email, whatsapp, tipo_negocio: tipoNegocio, plan_interes: planInteres, mensaje, consentimiento_contacto: 'si', consent_version: 'candidate_pr35_2026-10-21', ignored_fields: ignoredFields } }];"
